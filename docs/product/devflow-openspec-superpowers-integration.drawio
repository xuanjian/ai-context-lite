<mxfile host="app.diagrams.net" type="device">
  <diagram id="devflow-integration" name="DevFlow×OpenSpec×superpowers">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="DevFlow × OpenSpec × superpowers 集成：按需加载流程" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1410" height="40" as="geometry" />
        </mxCell>

        <!-- Arrows (back layer) -->
        <mxCell id="e_user_g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="nUser" target="dG1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g1_none" value="none" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="dG1" target="nNone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g1_light" value="light" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="dG1" target="nLight">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g1_full" value="full" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="dG1" target="nFull">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_full_spec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="nFull" target="dSpec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_spec_no" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="dSpec" target="nSpecNo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_spec_yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="dSpec" target="nSpecYes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_full_g1gate" value="进入完整 G1–G7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=12;" edge="1" parent="1" source="nFull" target="g1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_g1_g2" style="html=1;endArrow=block;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_g2_g3" style="html=1;endArrow=block;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_g3_g4" style="html=1;endArrow=block;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_g4_g5" style="html=1;endArrow=block;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_g5_g6" style="html=1;endArrow=block;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_g6_g7" style="html=1;endArrow=block;" edge="1" parent="1" source="g6" target="g7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Section A: on-demand routing -->
        <mxCell id="nUser" value="用户请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dG1" value="G1 任务分级&lt;br&gt;none / light / full" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="125" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="nNone" value="none：普通问答 / 代码片段 → 不读 DevFlow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nLight" value="light / L1–L2：轻量任务追踪&lt;br&gt;OpenSpec 跳过 · superpowers 一般不拉" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="145" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="nFull" value="full / L3–L4 / 规格输入 / 跨项目 / 高风险" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="215" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dSpec" value="full 时 G1 追问：&lt;br&gt;要不要 OpenSpec？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="910" y="115" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nSpecNo" value="否 → spec.status = none&lt;br&gt;不创建 openspec/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="90" width="250" height="44" as="geometry" />
        </mxCell>
        <mxCell id="nSpecYes" value="是 → 启用 spec 指针（轻绑定）&lt;br&gt;存 change id / path / status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="170" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- Section B: gate timeline -->
        <mxCell id="bandB" value="完整任务流程 G1–G7（仅 full 进入；缺省安全：缺失的层自动跳过）" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="G1 Intake&lt;br&gt;分级 · 是否 OpenSpec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="420" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="G2 Discovery&lt;br&gt;调研 · 证据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="420" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="G3 Plan / Spec&lt;br&gt;方案 / proposal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="420" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="G4 Development&lt;br&gt;按 spec 实现" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="420" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="G5 Integration&lt;br&gt;联调 · 环境" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="420" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="G6 Acceptance&lt;br&gt;对照 spec 验收" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1070" y="420" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="G7 Run / Archive&lt;br&gt;打包 · archive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1250" y="420" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- OpenSpec lane -->
        <mxCell id="osLabel" value="OpenSpec&lt;br&gt;状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="545" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="os3" value="proposed → approved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="545" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="os4" value="applied" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="545" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="os6" value="verified" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1070" y="545" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="os7" value="archived&lt;br&gt;合并回 openspec/specs/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1250" y="545" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- superpowers lane -->
        <mxCell id="spLabel" value="superpowers&lt;br&gt;(按需单条)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="630" width="130" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sp2" value="[可选] brainstorming" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="630" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sp3" value="[可选] writing-plans" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="630" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sp4" value="[可选] TDD / debugging" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="630" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="spNote" value="注册 ≠ 加载：登记进 DevFlow 索引仅表示可被检索，正文按 whenToLoad 懒触发" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="630" width="520" height="44" as="geometry" />
        </mxCell>

        <!-- Principles note -->
        <mxCell id="note" value="原则① 按需加载：跟随任务分级伸缩，none / light / L1–L2 不碰 OpenSpec 与 superpowers。&#10;原则② 缺省安全：openspec CLI 未装 或 superpowers 未注册 → 对应层自动跳过，任务照常跑通、不报错（package.json 不加硬依赖）。&#10;原则③ 工具无关：Codex / Claude Code / Cursor 共用同一套按需规则——Codex 本身同样不强制 OpenSpec。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="710" width="1430" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
